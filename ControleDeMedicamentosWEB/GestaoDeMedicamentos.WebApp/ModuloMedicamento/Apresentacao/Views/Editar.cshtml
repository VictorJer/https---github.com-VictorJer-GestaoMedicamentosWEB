@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar de Medicamento";
}

@model EditarMedicamentoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Editar"
      asp-route-id="@Model.Id" method="post">
    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
        <input asp-for="Nome" type="text" class="form-control">
        <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label fw-semibold text-primary text-uppercase small">Descricao</label>
        <input asp-for="Descricao" type="text" class="form-control">
        <span asp-validation-for="Descricao" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="QuantidadeEmEstoque" class="form-label fw-semibold text-primary text-uppercase small">Quantidade
            Em Estoque</label>
            <input asp-for="QuantidadeEmEstoque" type="text" class="form-control">
            <span asp-validation-for="QuantidadeEmEstoque" class="text-danger small fw-semibold"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FornecedorId"
                   class="form-label fw-semibold text-primary text-uppercase small">Fornecedor</label>
            <select asp-for="FornecedorId" class="form-select"
                    asp-items="@(new SelectList(ViewBag.Fornecedores, "Value", "Text"))">
                <option value="">Selecione um fornecedor</option>
            </select>
            <span asp-validation-for="FornecedorId" class="text-danger small fw-semibold"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
            <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
        </div>
    </form>
