@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Amigos";
}
@model List<ListarFornecedoresViewModel>


<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar Novo</a>


@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Nenhum amigo cadastrado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>CNPJ</th>
                    <th>Telefone</th>
                    <th class="text-center" style="width: 1%; white-space: nowrap;">açoes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ListarFornecedoresViewModel a in Model)
                {
                    <tr>
                        <td>@a.Id</td>
                        <td>@a.Nome</td>
                        <td>@a.CNPJ</td>
                        <td>@a.Telefone</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar"
                                   asp-route-id="@a.Id">Editar</a>
                                <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Excluir"
                                   asp-route-id="@a.Id">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
